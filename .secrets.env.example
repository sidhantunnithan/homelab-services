# Homelab Services - Secrets & Configuration (TEMPLATE)
#
# Copy to .secrets.env, fill in real values, and source it before running
# docker compose:
#   cp .secrets.env.example .secrets.env
#   source .secrets.env
#
# .secrets.env is gitignored and is the ONLY place real values belong.
# Never commit a filled-in copy, and never create .bak copies inside the repo.
#
# Enable the secret-blocking pre-commit hook once per clone:
#   git config core.hooksPath .githooks

# =============================================================================
# Core
# =============================================================================
# Public DNS zone used for *.internal.<domain> hostnames.
export BASE_DOMAIN=example.com

# =============================================================================
# Port Mappings (all published on 127.0.0.1 only)
# =============================================================================
export ACTUAL_PORT=
export AIRTRAIL_PORT=
export AUDIOBOOKSHELF_PORT=
export COPYPARTY_PORT=
export DELUGE_PORT=
export FRESHRSS_PORT=
export KOMGA_PORT=
export OBSIDIAN_PORT=
export SIM8085_PORT=
export TUWUNEL_PORT=

# =============================================================================
# Caddy (tailnet reverse proxy)
# =============================================================================
# Tailscale IP that Caddy binds to.
export CADDY_BIND_IP=
# Cloudflare API token, scoped to Zone:DNS:Edit for BASE_DOMAIN only.
export CADDY_CLOUDFLARE_API_TOKEN=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================
export CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# Obsidian (CouchDB)
# =============================================================================
export OBSIDIAN_COUCHDB_USER=
export OBSIDIAN_COUCHDB_PASSWORD=

# =============================================================================
# AirTrail
# =============================================================================
export AIRTRAIL_DB_PASSWORD=
# LAN-side origin for CORS, e.g. http://hostname:8008
export AIRTRAIL_LAN_ORIGIN=

# =============================================================================
# Tuwunel (Matrix homeserver, public via the Cloudflare tunnel)
# =============================================================================
# Permanent: user IDs are @name:<server name>. Changing it orphans all accounts.
export TUWUNEL_SERVER_NAME=
# Required to register; also set TUWUNEL_ALLOW_REGISTRATION=true while adding accounts.
export TUWUNEL_REGISTRATION_TOKEN=

# =============================================================================
# Copyparty
# =============================================================================
export COPYPARTY_PASSWORD=

# =============================================================================
# Images hosted in a private/personal registry
# =============================================================================
export SIM8085_IMAGE=

# =============================================================================
# Backups (rclone)
# =============================================================================
export RCLONE_CONFIG=
export MEDIA_ARCHIVE_BUCKET=
export SERVICE_DATA_BUCKET=
