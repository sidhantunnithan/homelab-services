# Example copyparty config template.
# Copy this to copyparty.conf and set real passwords before starting.

[accounts]
  admin: CHANGE_ME_ADMIN_PASSWORD
  user1: CHANGE_ME_USER1_PASSWORD

[/]
  /w
  accs:
    A: admin

[/media]
  /media
  accs:
    A: admin

[/private]
  /w/private
  accs:
    rw: user1
    A: admin
