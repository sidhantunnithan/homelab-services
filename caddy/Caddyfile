# Tailnet-only services. *.internal.<domain> resolves publicly to zeus-vm's
# tailnet IP, which is unreachable from outside the tailnet.
{
	# :80 on the tailnet IP belongs to `tailscale serve`; no HTTP redirect listener
	auto_https disable_redirects
	default_bind {$CADDY_BIND_IP}
}

*.internal.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}

	@airtrail host airtrail.internal.{$BASE_DOMAIN}
	handle @airtrail {
		reverse_proxy 127.0.0.1:{$AIRTRAIL_PORT}
	}

	@fitness host fitness.internal.{$BASE_DOMAIN}
	handle @fitness {
		root * /srv/pages
		rewrite / /fitness.html
		try_files {path} {path}.html
		file_server
	}

	handle {
		respond 404
	}
}
